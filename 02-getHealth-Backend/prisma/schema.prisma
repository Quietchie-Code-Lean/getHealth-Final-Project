generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PATIENT
  PROFESSIONAL
  ADMIN
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile      PatientProfile?
  professionalProfile ProfessionalProfile?
}

model PatientProfile {
  id                   Int       @id @default(autoincrement())
  patientId            Int       @unique
  phone                String?   @db.VarChar(30)
  dateOfBirth          DateTime? @db.Date
  identificationNumber String?   @unique @db.VarChar(50)

  user         User          @relation(fields: [patientId], references: [id])
  appointments Appointment[]
}

model ProfessionalProfile {
  id                   Int            @id @default(autoincrement())
  professionalId       Int            @unique
  licenseNumber        String         @unique @db.VarChar(50)
  approvalStatus       ApprovalStatus
  dateOfBirth          DateTime?      @db.Date
  identificationNumber String?        @unique @db.VarChar(50)

  user                    User                     @relation(fields: [professionalId], references: [id])
  appointments            Appointment[]
  availabilities          Availability[]
  professionalSpecialties ProfessionalSpeciality[]
}

model Speciality {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments            Appointment[]
  professionalSpecialties ProfessionalSpeciality[]
}

model ProfessionalSpeciality {
  id             Int      @id @default(autoincrement())
  professionalId Int
  specialityId   Int
  createdAt      DateTime @default(now())

  professionalProfile ProfessionalProfile @relation(fields: [professionalId], references: [id])
  speciality          Speciality          @relation(fields: [specialityId], references: [id])

  @@unique([professionalId, specialityId])
}

model Availability {
  id                    Int      @id @default(autoincrement())
  professionalProfileId Int
  weekday               Weekday
  startTime             DateTime @db.Time
  endTime               DateTime @db.Time
  slotDuration          Int
  availableSlot         Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id])
}

model Appointment {
  id                    Int               @id @default(autoincrement())
  patientProfileId      Int
  professionalProfileId Int
  specialityId          Int
  appointmentDate       DateTime          @db.Date
  startAppointment      DateTime          @db.Time
  endAppointment        DateTime          @db.Time
  status                AppointmentStatus
  reason                String?           @db.VarChar(500)
  cancellationReason    String?           @db.VarChar(500)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  patientProfile      PatientProfile      @relation(fields: [patientProfileId], references: [id])
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id])
  speciality          Speciality          @relation(fields: [specialityId], references: [id])

  @@unique([professionalProfileId, appointmentDate, startAppointment])
}
